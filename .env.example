# CamDX KYC Verification — environment configuration
#
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed
# (camdx_execution_plan.md §22).
#
# Every variable below is defined in backend/app/core/config.py, which is the
# authority. If you add one here, add it there.

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=local
APP_NAME=camdx-kyc-backend
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── Logging (§29) ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Allows request/response payloads in logs. UNSAFE — never enable in a shared or
# production environment. Biometric and identity data must never be logged.
LOG_SENSITIVE_PAYLOADS=false

# ─── CamDX (§21, §22) ─────────────────────────────────────────────────────────
# mock = fixtures, no network. real = live CamDigiKey, requires credentials.
# The backend refuses to start in real mode without CAMDX_BASE_URL,
# CAMDX_CLIENT_ID and CAMDX_CLIENT_SECRET. It never silently falls back to mock.
CAMDX_MODE=mock

# Leave blank in mock mode. Ask CamDX for the sandbox base URL.
CAMDX_BASE_URL=
CAMDX_CLIENT_ID=
CAMDX_CLIENT_SECRET=
# Only if the integration requires it.
CAMDX_API_KEY=
CAMDX_TIMEOUT=30

# Adds upstream codes and scores to results for a developer view (§24).
# Keep false in anything a user can see.
CAMDX_EXPOSE_DEVELOPER_VIEW=false

# ─── OCR capture ────────────────────────────────────────────────────────────
# `mock` = fixtures, no real read. `tesseract` = real on-device capture of the
# uploaded image. Tesseract never calls CamDX.
OCR_PROVIDER=tesseract
OCR_LANGUAGES=eng+khm
# Local Ollama for NLP capture. Leave unset for the Docker stack (it defaults to
# host.docker.internal). For local non-Docker runs point it at the host:
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ─── Authentication / RBAC (D18) ─────────────────────────────────────────────
# Require sign-in for the whole API and enforce the six CamDigiKey method
# permissions per role. Tests force this off; a deployment never should.
# The default administrator is seeded on first start:
#   admin@gmail.com / P4ssw0rd!
AUTH_ENABLED=true

# ─── HTTP ─────────────────────────────────────────────────────────────────────
# Comma-separated, explicit origins. Wildcards are rejected at startup.
CORS_ORIGINS=http://localhost:5173

# ─── Uploads (§7, §29) ───────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760
MIN_IMAGE_WIDTH=640
MIN_IMAGE_HEIGHT=480

# ─── Temporary biometric storage (§29) ────────────────────────────────────────
# Must stay outside any static mount. Never point this at a served directory.
TEMP_STORAGE_DIR=var/tmp
TEMP_ARTIFACT_TTL_SECONDS=900
TEMP_SWEEP_INTERVAL_SECONDS=60

# ─── PostgreSQL / identity registry (§4, D13) ────────────────────────────────
# Verification compares the submitted identity against stored sample records.
# Compose starts `postgres` with the default stack and injects its own
# in-network `DATABASE_URL` into the app container, so the value below only
# matters when running the backend on the host (`make backend-run`).
#
# Password rules: letters and digits only (it is interpolated into a connection
# URL), and change it in `.env`, never here. Changing it after the first
# `docker compose up` also needs `docker compose down -v` — PostgreSQL only
# reads POSTGRES_PASSWORD when it initialises its volume.
POSTGRES_USER=camdx
POSTGRES_PASSWORD=camdx_local_only
POSTGRES_DB=camdx_kyc

# Host-run DSN. Leave empty to verify against the bundled fixtures instead —
# no database needed, which is what the test suite forces. With the compose
# stack running, PostgreSQL is published on localhost:5432, so this works:
# DATABASE_URL=postgresql+psycopg://camdx:camdx_local_only@localhost:5432/camdx_kyc
DATABASE_URL=

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Empty in development (Vite proxies /api to the backend). In production the
# backend serves the built assets, so this stays empty too.
VITE_API_BASE_URL=